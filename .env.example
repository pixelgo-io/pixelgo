# Copy this file to .env and put your real keys:
#   cp .env.example .env
#   chmod 600 .env
#
# You only need keys for the providers you use.

# Anthropic (Claude) - https://console.anthropic.com  (requires credit)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (ChatGPT) - https://platform.openai.com  (requires credit;
#   a ChatGPT Plus subscription does NOT include API access)
OPENAI_API_KEY=sk-...

# Google (Gemini) - https://aistudio.google.com/apikey  (has a FREE tier)
GEMINI_API_KEY=AIza...

# Optional: the logging level (debug | info | warn | error)
PIXELGO_LOG_LEVEL=info
