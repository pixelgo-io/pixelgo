# Copy this file to .env and put your real keys:
#   cp .env.example .env
#   chmod 600 .env
#
# You only need keys for the providers you use.

# Anthropic (Claude) - https://console.anthropic.com  (requires credit)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (ChatGPT) - https://platform.openai.com  (requires credit;
#   a ChatGPT Plus subscription does NOT include API access)
OPENAI_API_KEY=sk-...

# Google (Gemini) - https://aistudio.google.com/apikey  (has a FREE tier)
GEMINI_API_KEY=AIza...

# Optional: the logging level (debug | info | warn | error)
PIXELGO_LOG_LEVEL=info

# Optional: raises the web UI's request-body cap for the data-edit dialog
# (default 64KB, ceiling 4MB). Accepts a size like "2MB" or a raw byte
# count. Only matters if you set a large --data-threshold. See DOCS.md.
# PIXELGO_HTTP_MAX_BODY=2MB

# Optional: default --data-threshold for any agent that doesn't set its own
# (a size like "500KB"/"2MB", or "off"). See DOCS.md.
# PIXELGO_DATA_THRESHOLD=500KB
